
{
  "expo": {
    "name": "FoodArena",
    "slug": "FoodArena",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications",
      ["expo-location", {"locationWhenInUsePermission": "Allow FoodArena to use your location."}
    ]],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dotunadeusi.unilagmarketplace",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dotunadeusi.unilagmarketplace",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "8d15cfc7-131d-4831-8214-83d001c8edf1"
      }
    }
  }
}
